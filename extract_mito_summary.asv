subplot(4,1,4);
plot(t0, ca_mito0, 'LineWidth', 1.5, 'Color', [0.47 0.67 0.19]);
ylabel('Ca_{mito,0} (\muM)');

figure('Name', 'Mito 0 Trace ATP/ADP', 'Position', [1050 100 900 1050]);
yyaxis left;
plot(t0, atp0, 'LineWidth', 1.5);
ylabel('ATP_0 (\muM)');
yyaxis right;
plot(t0, adp0, 'LineWidth', 1.5);
ylabel('ADP_0 (\muM)');

