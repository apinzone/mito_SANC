%% Biomarkers -> CSV
results = biomarkers('ci.txt', 'ikatp_inak_serca_trace.txt', run_label, 20000, false);

row = struct();
row.label = {results.label};

row.BCL_vm_mean = mean(results.BCL_vm, 'omitnan');
row.BCL_vm_sd   = std(results.BCL_vm, 'omitnan');
row.CaT_CL_mean = mean(results.CaT_CL, 'omitnan');
row.CaT_CL_sd   = std(results.CaT_CL, 'omitnan');

fn = fieldnames(results.cat_markers);
for i = 1:numel(fn)
    vals = results.cat_markers.(fn{i});
    row.([fn{i} '_mean']) = mean(vals, 'omitnan');
    row.([fn{i} '_sd'])   = std(vals, 'omitnan');
end

fn_c = fieldnames(results.currents);
for i = 1:numel(fn_c)
    if strcmp(fn_c{i}, 'time'), continue; end  % raw time vector, not a biomarker
    vals = results.currents.(fn_c{i});
    row.([fn_c{i} '_mean']) = mean(vals, 'omitnan');
    row.([fn_c{i} '_sd'])   = std(vals, 'omitnan');
end

row.ATP_ave_max = max(results.currents.ATP_ave, [], 'omitnan');
row.ATP_ave_min = min(results.currents.ATP_ave, [], 'omitnan');
cl = cl_upstroke(t_ci, vm_ci, 20000);        
row.CL_thr_median  = median(cl.CL_thr,  'omitnan');
row.CL_dvdt_median = median(cl.CL_dvdt, 'omitnan');
row.CL_dvdt_sd     = std(cl.CL_dvdt,    'omitnan');

T = struct2table(row);

writetable(T, sprintf('biomarkers_%s.csv', run_label));
fprintf('Saved biomarker summary: biomarkers_%s.csv\n', run_label);

%% Mito Ca shuttle vs SERCA (last window, per beat)
% Volumes from subcell.cpp (finemesh = 1), in um^3 (= fL)
vp     = 0.00126 * 2;        % cleft volume per CRU (vp_ave, r = 0)
vi     = 1.5 * 0.5;          % cytosolic volume per CRU
V_mito = vi * (3.3/5.0);     % mito volume
mito_per_CRU = 1/4;          % 8:1 run -> 1/8 ; 4:1 run -> 1/4

win_ms = 20000;              % analyse last 20 s
w  = t       >= t(end)       - win_ms;
wt = t_trace >= t_trace(end) - win_ms;

BCL = row_BCL_guess();       % replaced below if biomarkers ran
if exist('results','var') && isfield(results,'BCL_vm')
    BCL = mean(results.BCL_vm,'omitnan');
end

% Mean fluxes over the window (uM/ms in each compartment's own volume)
Jflux_cp   = mean(data.avg_Jflux_cp(w));     % cleft debit per producer CRU
NCXflux_ci = mean(data.avg_NCXflux_ci(w));   % cytosolic credit per producer CRU
Iup        = mean(iup_avg(wt));              % SERCA uptake per CRU

% Amount moved per beat, in uM*um^3 (= zeptomol; 1 zmol ~ 602 ions)
mcu_per_mito  = Jflux_cp   * vp * BCL;       % Ca taken from cleft per mito per beat
nclx_per_mito = NCXflux_ci * vi * BCL;       % Ca returned to cytosol per mito per beat
serca_per_CRU = Iup        * vi * BCL;       % Ca pumped into SR per CRU per beat

% Whole-cell ratio: (MCU per mito x mitos per CRU) / SERCA per CRU
shuttle_frac = (mcu_per_mito * mito_per_CRU) / serca_per_CRU;

fprintf('\n--- Mito Ca shuttle (last %.0f s, BCL %.1f ms) ---\n', win_ms/1000, BCL);
fprintf('MCU uptake per mito per beat  : %.3f zmol (~%.0f Ca ions)\n', mcu_per_mito,  mcu_per_mito*602);
fprintf('NCLX return per mito per beat : %.3f zmol (~%.0f Ca ions)\n', nclx_per_mito, nclx_per_mito*602);
fprintf('SERCA uptake per CRU per beat : %.3f zmol (~%.0f Ca ions)\n', serca_per_CRU, serca_per_CRU*602);
fprintf('Mito shuttle / SERCA (whole cell): %.2f %%\n', 100*shuttle_frac);

function b = row_BCL_guess()
b = 107;   % fallback cycle length (ms) if biomarkers() has not run
end

function vals = read_vtk_scalars(filename)
fid = fopen(filename, 'r');
tline = fgetl(fid);
n_points = 0;
while ischar(tline)
    if startsWith(tline, 'POINT_DATA')
        parts = strsplit(tline);
        n_points = str2double(parts{2});
    end
    if startsWith(tline, 'LOOKUP_TABLE'), break; end
    tline = fgetl(fid);
end
vals = fscanf(fid, '%f', n_points);
fclose(fid);
end